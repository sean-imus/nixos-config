diff --git a/src/wfd/p2p/wpa.py b/src/wfd/p2p/wpa.py
new file mode 100644
index 0000000..58a03cc
--- /dev/null
+++ b/src/wfd/p2p/wpa.py
@@ -0,0 +1,107 @@
+import shutil
+import subprocess
+import time
+from typing import Optional
+
+from ..config import WFDNotReady
+from ..proc import _run
+from .peers import _default_wifi_interface
+
+
+def _wpa_cli(args, iface, timeout=5.0) -> str:
+    """Run wpa_cli against the given interface's control socket."""
+    if not shutil.which("wpa_cli"):
+        raise WFDNotReady("wpa_cli is required for the wpa_supplicant P2P path.")
+    result = _run(["wpa_cli", "-i", iface, *args], timeout=timeout)
+    if result.returncode != 0:
+        raise WFDNotReady((result.stderr or result.stdout).strip())
+    return result.stdout.strip()
+
+
+def _p2p_group_interfaces() -> list[str]:
+    """List p2p-* netdevs currently present."""
+    if not shutil.which("ip"):
+        return []
+    result = _run(["ip", "-br", "link"], timeout=5.0)
+    groups = []
+    for line in result.stdout.splitlines():
+        name = line.split(":")[0].strip()
+        if name.startswith("p2p-"):
+            groups.append(name)
+    return groups
+
+
+def _wait_for_group_interface(iface: str, timeout: float = 60.0) -> str:
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        for g in _p2p_group_interfaces():
+            if g.startswith("p2p-" + iface) or g.startswith("p2p-"):
+                return g
+        time.sleep(1.0)
+    raise WFDNotReady("Timed out waiting for the P2P group interface to appear.")
+
+
+def _wait_for_ip(group_iface: str, timeout: float = 60.0) -> str:
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        try:
+            result = _run(["ip", "-br", "-4", "addr", "show", group_iface], timeout=5.0)
+        except (OSError, subprocess.TimeoutExpired):
+            time.sleep(1.0)
+            continue
+        for line in result.stdout.splitlines():
+            parts = line.split()
+            for p in parts:
+                if "/" in p and not p.startswith("fe80:"):
+                    return p.split("/")[0]
+        time.sleep(1.0)
+    raise WFDNotReady(f"Timed out waiting for an IP address on {group_iface}.")
+
+
+def _wpa_connect_peer(peer, iface: Optional[str] = None, go_intent: int = 0,
+                      timeout: float = 60.0) -> tuple[str, str]:
+    """Connect to a P2P peer via wpa_supplicant directly, bypassing NetworkManager.
+
+    The sink is expected to become the Group Owner (go_intent=0) and serve DHCP;
+    we become the client and obtain an IP from it.
+    Returns (group_iface, ip).
+    """
+    iface = iface or _default_wifi_interface()
+    if not iface:
+        raise WFDNotReady("Could not detect a managed Wi-Fi interface for wpa_cli.")
+
+    print(f"[FluxCast WFD] Connecting to {peer.name or peer.address} via wpa_supplicant "
+          f"on {iface} (go_intent={go_intent})...")
+
+    out = _wpa_cli(["p2p_connect", peer.address, "pbc", f"go_intent={go_intent}"],
+                   iface, timeout=10.0)
+    if "OK" not in out:
+        raise WFDNotReady(f"wpa_cli p2p_connect failed: {out.strip()}")
+
+    group_iface = _wait_for_group_interface(iface, timeout=timeout)
+
+    if shutil.which("dhcpcd"):
+        _run(["dhcpcd", "-b", "-4", "--noipv4ll", group_iface], timeout=10.0)
+    ip = _wait_for_ip(group_iface, timeout=timeout)
+
+    print(f"[FluxCast WFD] P2P group {group_iface} up, IP {ip}.")
+    return group_iface, ip
+
+
+def _wpa_disconnect(peer, group_iface: str, iface: Optional[str] = None):
+    """Tear down a P2P group formed via wpa_supplicant."""
+    if not group_iface:
+        return
+    iface = iface or _default_wifi_interface()
+    if shutil.which("dhcpcd"):
+        try:
+            _run(["dhcpcd", "--release", group_iface], timeout=5.0)
+        except Exception:
+            pass
+    if not iface:
+        return
+    try:
+        out = _wpa_cli(["p2p_group_remove", group_iface], iface, timeout=5.0)
+        print(f"[FluxCast WFD] P2P group removed: {out}")
+    except Exception as exc:
+        print(f"[FluxCast WFD] P2P group removal warning: {exc}")
